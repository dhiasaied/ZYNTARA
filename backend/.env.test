APP_ENV=test
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
MESSENGER_TRANSPORT_DSN=in-memory://
MESSENGER_RUNS_TRANSPORT_DSN=in-memory://
MERCURE_ENABLED=0
