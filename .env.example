# Copy to .env and change every secret before deploying:  cp .env.example .env
# Generate secrets with:  openssl rand -hex 32

HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080

APP_SECRET=change-me-app-secret
JWT_PASSPHRASE=change-me-jwt-passphrase
JWT_TTL=86400
MERCURE_JWT_SECRET=change-me-mercure-secret-at-least-32-chars
INTERNAL_API_TOKEN=change-me-internal-token

POSTGRES_DB=zyntara
POSTGRES_USER=zyntara
POSTGRES_PASSWORD=change-me-postgres
# Password of the read-only role used by the database_query tool
BUSINESS_DB_PASSWORD=change-me-readonly

# Load the demo workspace (users, agents, crew, a knowledge base) on first start
SEED_DEMO=1
WORKER_REPLICAS=2

# --- LLM providers (all optional: the offline "mock" provider always works) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# e.g. http://host.docker.internal:11434
OLLAMA_BASE_URL=
# auto | openai | ollama | hash
EMBEDDING_PROVIDER=auto

# --- Tools ---
TAVILY_API_KEY=
# Defaults to the bundled Mailpit (http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ZYNTARA Agent <agent@zyntara.local>
SMTP_STARTTLS=false
